# Copy this file to .env and fill in the values. Never share .env.
# facebook = Instagram API with Facebook Login (recommended), instagram = Instagram Login
IG_LOGIN=facebook
IG_ACCESS_TOKEN=
# Optional: auto-detected from your linked Facebook Page if left empty
IG_USER_ID=
IG_API_VERSION=v23.0
# Needed (facebook mode) to auto-renew the 60-day token
FB_APP_ID=
FB_APP_SECRET=
# Public base URL where images/videos are hosted (Instagram fetches media from a URL)
PUBLIC_MEDIA_BASE_URL=
